<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- JARVIS ULTIMATE 4.0 MAIN THEME -->

    <style
        name="Theme.Jarvis"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <!-- Main Background -->

        <item name="android:windowBackground">
            #050C16
        </item>

        <!-- Status Bar -->

        <item name="android:statusBarColor">
            #050C16
        </item>

        <!-- Navigation Bar -->

        <item name="android:navigationBarColor">
            #050C16
        </item>

        <!-- Light Status Bar Disabled -->

        <item name="android:windowLightStatusBar">
            false
        </item>

        <!-- Primary Colors -->

        <item name="colorPrimary">
            #00E5FF
        </item>

        <item name="colorPrimaryDark">
            #003B49
        </item>

        <item name="colorAccent">
            #00E5FF
        </item>

        <!-- Android Accent -->

        <item name="android:colorAccent">
            #00E5FF
        </item>

        <!-- Text Color -->

        <item name="android:textColorPrimary">
            #FFFFFF
        </item>

        <item name="android:textColorSecondary">
            #B0BEC5
        </item>

        <!-- Window Settings -->

        <item name="android:windowActionModeOverlay">
            true
        </item>

        <item name="android:windowNoTitle">
            true
        </item>

        <item name="android:windowActionBar">
            false
        </item>

    </style>

</resources>
